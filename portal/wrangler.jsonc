{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thekliento",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "thekliento.com/*", "zone_name": "thekliento.com" },
    { "pattern": "www.thekliento.com/*", "zone_name": "thekliento.com" }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/data/*", "/login", "/login/*", "/setup", "/app", "/app/*", "/api/*"]
  },
  "vars": {
    "RP_NAME": "Kliento Portal",
    "PROD_HOST": "thekliento.com",
    "DATA_ORIGIN": "https://raw.githubusercontent.com/thekliento/kliento_website/main/data/",
    "REQUEST_TO": "crivas@thekliento.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kliento-portal", "database_id": "a268229f-532c-4ec6-aad0-160f5fb87721" }
  ],
  "kv_namespaces": [
    { "binding": "FILES", "id": "697b096c109846c19daad6704fdea298" }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "6101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_API", "namespace_id": "6102", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["17 8 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
